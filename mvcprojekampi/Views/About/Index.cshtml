@using EntityLayer.Concrete
@model List<About>


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Hakkımda Veri Listesi</h2>
<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Hakkımda Başlığı</th>
        <th>Aktif Yap</th>
        <th>Pasif Yap</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AboutID</td>
            <td>Başlık</td>
            <td>
                @if (!item.AboutStatus)
                {
                    <a href="/About/MakeActive/@item.AboutID" class="btn btn-warning">Aktif Yap</a>
                }
                else
                {
                    <span class="badge bg-success">Aktif</span>
                }
            </td>
            <td>
                @if (item.AboutStatus)
                {
                    <a href="/About/MakePassive/@item.AboutID" class="btn btn-danger">Pasif Yap</a>
                }
                else
                {
                    <span class="badge bg-secondary">Pasif</span>
                }
            </td>

        </tr>
    }
</table>



@Html.Action("AboutPartial","About")